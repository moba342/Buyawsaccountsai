# Public Google HTML verification value from Search Console (not a fake token).
# On Vercel, configure this for the Production build. Locally export it before npm run build.
GOOGLE_SITE_VERIFICATION=
# Optional public measurement IDs. Trackers stay disabled until a user grants consent.
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
# Use one integration at a time if GTM already configures GA4 to avoid duplicate events.
# Keep RPC credentials server-only; never prefix secrets with VITE_.
# Required before optional analytics can activate: your actual published privacy notice URL.
VITE_ANALYTICS_PRIVACY_URL=
