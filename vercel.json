{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/products/",
      "destination": "/index.html"
    },
    {
      "source": "/providers/",
      "destination": "/index.html"
    },
    {
      "source": "/compare/",
      "destination": "/index.html"
    },
    {
      "source": "/guides/",
      "destination": "/index.html"
    },
    {
      "source": "/faq/",
      "destination": "/index.html"
    },
    {
      "source": "/contact/",
      "destination": "/index.html"
    },
    {
      "source": "/verified/",
      "destination": "/index.html"
    },
    {
      "source": "/:provider-accounts/",
      "destination": "/index.html"
    },
    {
      "source": "/product/:slug/",
      "destination": "/index.html"
    }
  ]
}
