{
  "name": "cloudlane",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --ssr entry-server.jsx --outDir .ssg-build",
    "preview": "vite preview --host 0.0.0.0",
    "generate:payment-qr": "node scripts/generate-payment-qr.mjs",
    "prebuild": "npm run generate:payment-qr && node scripts/generate-media.mjs",
    "test": "node --test tests/*.test.js",
    "postbuild": "node scripts/generate-seo.mjs",
    "preview:production": "node server/static-preview.mjs",
    "validate:seo": "node scripts/validate-seo.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.28",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  }
}
